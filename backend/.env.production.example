# ==============================================================================
# Production environment reference — KEY NAMES ONLY, no values.
#
# You do NOT upload this file, and you do NOT upload .env. On Render these keys
# live in the "sungguard-shared" environment group (created automatically by
# /render.yaml at the repo root); you fill the blank ones in the dashboard once.
#
# This file exists to answer "which keys must I fill in, and which must I leave
# alone" — the differences from your local .env are what matter.
# ==============================================================================

# ── Set by the platform, never by you ─────────────────────────────────────────
# NODE_ENV          -> render.yaml pins this to "production" per service.
#                      It is absent from .env on purpose: .env is your local
#                      dev file. Without it the code defaults to "development"
#                      (index.js), which leaks stack traces and turns mock OTP
#                      on. Never add it to .env.
# REDIS_URL         -> injected from the Key Value service via `fromService`.
# PORT              -> injected by Render; index.js reads it and falls back to
#                      7000 locally. Do not pin it in the dashboard.
# NODE_VERSION      -> pinned to 22 in the shared env group.
# PROCESS_ROLE      -> api | worker | scheduler, one per service.

# ── MUST NOT be set in production ─────────────────────────────────────────────
# USE_MOCK_OTP      Your local .env sets this to true. In production it makes
#                   every OTP request throw a 500 (otp.service.js), and it
#                   overrides NODE_ENV, so production alone will not save you.
# REDIS_DISABLED    Your local .env sets this to true. In production this
#                   throws on boot (app/config/redis.js). render.yaml pins it
#                   to "false" so a copied value cannot re-disable Redis.
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
#                   Superseded by REDIS_URL. Leave unset.

# ── Differs from your local .env — change the value, do not copy ──────────────
PHONEPE_ENV=            # local is SANDBOX; production must be PRODUCTION
FRONTEND_URL=           # not present locally at all. Required: drives CORS and
                        # the PhonePe return URL. Unset, that redirect becomes
                        # "undefined/payment-status" and payments break.
CORS_ALLOWED_ORIGINS=   # optional; overrides FRONTEND_URL when set

# ── Secrets to paste into the Render dashboard ────────────────────────────────
MONGO_URI=
JWT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMS_INDIA_HUB_URL=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_GWID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_TEMPLATE_TEXT=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=

FIREBASE_SERVICE_ACCOUNT=   # full service-account JSON, collapsed to one line
FIREBASE_DATABASE_URL=

GOOGLE_MAPS_API_KEY=
API_BASE_URL=               # public URL of the deployed API service

# ── Tunables with sane defaults already in render.yaml ────────────────────────
# JWT_EXPIRES_IN, USE_REAL_SMS, OTP_* , MAPS_RL_*, PICKUP_RADIUS_METERS,
# RETURN_WINDOW_MINUTES, DEFAULT_DELIVERY_TIMEOUT_MS,
# DELIVERY_BROADCAST_REQUIRE_VERIFIED, LOG_LEVEL, TRUST_PROXY,
# AUTO_CANCEL_INTERVAL_MS, PAYOUT_BATCH_INTERVAL_MS, ENABLE_PAYOUT_BATCH_JOB
# Override in the dashboard only if you need something other than the default.
